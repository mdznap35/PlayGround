# NOVA environment — placeholders ONLY. Never commit real secrets.
# Copy to .env for local dev. Only VITE_* keys reach the client build.

# Keyless weather API base (Open-Meteo). Change only for mirrors/tests.
VITE_WEATHER_ENDPOINT=https://api.open-meteo.com/v1/forecast
# Optional AI gateway speaking OpenAI-compatible /chat/completions.
# Empty = AI fully disabled (default, offline-safe).
VITE_AI_ENDPOINT=
# Public client identifier sent with gateway calls (NOT a secret).
VITE_AI_PUBLIC_ID=nova-kids-app

# --- SECRET (NEVER VITE_*, never in client JS, gateway/server only) ---
# GEMINI_API_KEY=
# OPENROUTER_API_KEY=
# ELEVENLABS_API_KEY=
